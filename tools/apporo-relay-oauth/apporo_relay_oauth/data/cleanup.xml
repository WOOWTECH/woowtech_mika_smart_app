<odoo noupdate="1">
    <record id="cron_apporo_relay_oauth_cleanup" model="ir.cron">
        <field name="name">Apporo relay: remove expired identity credentials</field>
        <field name="model_id" ref="model_apporo_relay_oauth_code"/>
        <field name="state">code</field>
        <field name="code">model._cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
