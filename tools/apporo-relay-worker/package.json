{
  "name": "apporo-assistant-relay",
  "private": true,
  "scripts": {
    "types": "wrangler types",
    "check": "wrangler types && tsc --noEmit",
    "test": "python3 -m unittest discover -s test -p 'test_cli_*.py' && node test/smoke.mjs",
    "test:accounts": "node test/accounts.mjs",
    "test:provider": "node test/accounts.mjs --provider",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.159.0",
    "ws": "8.22.2"
  }
}
