<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>chat.attach.imagesNotSeen</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>The main model can’t see images, so %lld image wasn’t sent to a model. Choose a vision model on the model settings page.</string>
			<key>other</key>
			<string>The main model can’t see images, so %lld images weren’t sent to a model. Choose a vision model on the model settings page.</string>
		</dict>
	</dict>
