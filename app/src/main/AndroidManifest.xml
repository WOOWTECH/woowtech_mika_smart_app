<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 按住说话时录音，转成文字。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 沙箱联网时读当前网络的 DNS 服务器 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 对话页附件可以拍照(走系统相机),声明用到相机、但不是必需:没有相机的设备照常安装。
         有的系统按 APK 特征给应用分类,不声明时 Mika 可能被当成游戏、限制刷新率;这条声明要留着 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 语音输入要麦克风,但不是必需:没有麦克风的设备照常安装,只是用不了语音 -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- list_apps 列出可启动的 App;解析系统权限框所在的包,用于判断「被切走」 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.content.pm.action.REQUEST_PERMISSIONS" />
        </intent>
        <!-- 系统动作:先查有没有时钟、日历 App 接,没有就退回去操作界面 -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <!-- 语音输入:安卓 11 起不声明这条,查手机自带识别服务永远查不到 -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- 引导页先看系统里打不打得开开发者选项页:打不开(有的运行环境不带安卓的系统设置)就一开始说明手机操作用不了 -->
        <intent>
            <action android:name="android.settings.APPLICATION_DEVELOPMENT_SETTINGS" />
        </intent>
        <!-- 账号认证器所在的包:没有桌面图标的系统账号登录服务也要看得见,它的登录页冒到主屏上时留给用户处理 -->
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
    </queries>

    <application
        android:name=".MikaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 界面只有一个:从桌面、通知、别的 App 或命令打开都回到这一个(新的打开交给 onNewIntent),不在上面叠出第二个 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Mika"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 通知里接管按钮的落点:从通知启动 Activity 才会收起通知栏,让用户直接看到挪到主屏的 App -->
        <activity
            android:name=".takeover.TakeoverActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- App 里的文件查看页(网页、Markdown、PDF、图片、文本) -->
        <activity
            android:name=".ui.viewer.FileViewerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:exported="false"
            android:theme="@style/Theme.Mika" />

        <!-- 网页接管:把后台的网页标签(同一个 WebView)拿到主屏给用户处理 -->
        <activity
            android:name=".web.WebTakeoverActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".task.TaskService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a user-requested AI conversation or in-app browser task running while showing its progress" />
        </service>

        <!-- 用 ChatGPT 登录期间:用户在浏览器里登录时撑住进程,本机回调才有人接;登录一结束就停 -->
        <service
            android:name=".settings.ChatGptSignInService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps sign-in alive while the user finishes account login in the external browser, for a loopback callback or device-code polling" />
        </service>

        <!-- 后台准备运行环境(解出随 APK 自带的根文件系统),只在准备期间运行 -->
        <service
            android:name=".sandbox.SandboxService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 网页上传:把暂存的上传文件以只读 content:// 地址交给内置浏览器的文件选择框,不对外导出。
             FileProvider 要求 grantUriPermissions=true,否则进程启动时就抛异常;
             这里从不把地址授权给别的 App,读取方只有本进程里的 WebView。 -->
        <provider
            android:name=".web.WebFilesProvider"
            android:authorities="${applicationId}.webfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/web_files" />
        </provider>

        <!-- 对话页附件:相机把照片写进缓存里的 camera/,点开已发附件时复制出的一份在 viewing/;不对外导出,用到时临时授权 -->
        <provider
            android:name=".chat.AttachFilesProvider"
            android:authorities="${applicationId}.attachfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attach_files" />
        </provider>

        <!-- 配对通知输入框填的配对码 -->
        <receiver
            android:name=".setup.PairingCodeReceiver"
            android:exported="false" />

    </application>

</manifest>
